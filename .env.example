# ThriveLife — environment template
# Copy to apps/web/.env.local. Never commit real secrets.

# Public app URL
# VITE_APP_URL=http://127.0.0.1:3000

# Supabase (Canada Central project ThriveLife)
# Use the publishable key in the browser. NEVER put the service_role key in VITE_* vars.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy anon JWT (optional compatibility)
# VITE_SUPABASE_ANON_KEY=

# Server-only (apps/web/.env.local, not exposed to the client):
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Dual-writes sessions + content when URL + service role are set. JSON is still
# the local source of truth. Never put service_role in VITE_* vars.

# Optional Day 3/7 mailer. Without keys, reminders are logged only.
# RESEND_API_KEY=
# MAIL_FROM=ThriveLife <noreply@localhost>
# SMTP_URL=  # acknowledged; V1 logs rather than pretending SMTP send

# Optional error beacon (no Sentry SDK — ignored when unset)
# VITE_SENTRY_DSN=

# Production / real users:
# - Deploy with `npm run build && npm run start` (Node serves SPA + /api).
# - NODE_ENV=production requires Supabase JWT on member APIs.
# - Do not set TL_ALLOW_DEV_HEADERS in production.
# VITE_ALLOW_DEMO_AUTH=true   # only for fixture demos; hides nothing when unset in PROD+Supabase
# VITE_ALLOW_CONTENT_INVITE=true  # allow Joel invite codes outside strict cloud mode
# TL_REQUIRE_JWT=1
# TL_ALLOW_DEV_HEADERS=1      # DEV/test only
# PORT=8080
# SUPABASE_ANON_KEY=          # server JWT verify if not using VITE_ publishable key
# HOST=0.0.0.0

# Joel / content owner invite (Pages + local staging). Default: joel-thrivelife-content
# Disabled automatically when NODE_ENV=production on the API.
# VITE_CONTENT_INVITE_CODE=
# CONTENT_INVITE_CODE=

# Hosting: prefer ca-central-1 (Canada Central). See docs/PRODUCTION.md.
# Legal confirm before public beta.

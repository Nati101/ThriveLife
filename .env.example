# ThriveLife — environment template
# Copy to apps/web/.env.local. Never commit real secrets.

# Public app URL
# VITE_APP_URL=http://127.0.0.1:3000

# Supabase (Canada Central project ThriveLife)
# Use the publishable key in the browser. NEVER put the service_role key in VITE_* vars.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy anon JWT (optional compatibility)
# VITE_SUPABASE_ANON_KEY=

# Server-only (apps/web/.env.local, not exposed to the client):
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Dual-writes sessions + content when URL + service role are set. JSON is still
# the local source of truth. Never put service_role in VITE_* vars.

# Optional Day 3/7 mailer. Without keys, reminders are logged only.
# RESEND_API_KEY=
# MAIL_FROM=ThriveLife <noreply@localhost>
# SMTP_URL=  # acknowledged; V1 logs rather than pretending SMTP send

# Optional error beacon (no Sentry SDK — ignored when unset)
# VITE_SENTRY_DSN=

# Hosting: prefer ca-central-1 (Canada Central). Legal confirm before beta.
